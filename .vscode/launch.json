    "version": "0.2.0",
    "configurations": [

        {
            "name": "thrustercommand",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/thruster_command.py",
            "args": ["/dev/ttyUSB0", "0x22", "scripts/thruster-control.eds"],
            "console": "integratedTerminal"
        },
                {
            "name": "listener gui",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/listener.py",
            "args": ["--gui"],
            "console": "integratedTerminal"
        }
    ]
}